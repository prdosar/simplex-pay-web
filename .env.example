# === SimplexPay — variables d'environnement pour docker-compose.full.yml ===
# Copier ce fichier en `.env` (gitignoré) et remplir les valeurs réelles.
#   cp .env.example .env && chmod 600 .env

# --- Base de données ---
POSTGRES_PASSWORD=change-me-strong-password

# --- JWT ---
# Générer avec : openssl rand -base64 64
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-base64-64
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# --- URLs publiques (utilisées par CORS + liens d'email) ---
WEB_URL=https://simplex-pay.com
ADMIN_URL=https://appchange.simplex-pay.com
API_PUBLIC_URL=https://apichange.simplex-pay.com

# --- Ports hôte (mapping docker → host) ---
# Choisir des ports libres sur le VPS. Nginx système fera le reverse-proxy.
API_PORT=5041
WEB_PORT=3003
ADMIN_PORT=3004

# --- SMTP (OVH) ---
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=noreply@simplex-pay.com
SMTP_PASS=change-me-ovh-mailbox-password
SMTP_FROM=noreply@simplex-pay.com

# --- Email verification ---
EMAIL_VERIFICATION_EXPIRY_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
